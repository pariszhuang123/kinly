    "version": "0.2.0",
    "configurations": [
        


        {
            "name": "Kinly (dev)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "args": [
                "--flavor", "dev",
                "--dart-define-from-file=env/dev.json"
            ]
        },
        {
            "name": "kinly (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "kinly (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}