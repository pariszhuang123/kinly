# fastlane/Fastfile

default_platform(:android)

platform :android do
  desc "Upload the prod AAB to Google Play closed testing (beta track by default)"
  lane :deploy_closed do
    track          = ENV["PLAY_TRACK"] || "beta"       # Play Console closed testing
    release_status = ENV["PLAY_RELEASE_STATUS"] || "completed"
    aab_path       = ENV["AAB_PATH"] || "build/app/outputs/bundle/prodRelease/app-prod-release.aab"

    # Ensure the bundle exists before calling Play
    UI.user_error!("AAB not found at #{aab_path}. Build it first (flutter build appbundle --flavor prod --release).") unless File.exist?(aab_path)

    upload_to_play_store(
      aab: aab_path,
      track: track,
      release_status: release_status,
      # package_name & json_key_file are taken from Appfile
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      validate_only: ENV["PLAY_VALIDATE_ONLY"] == "true"
    )
  end
end
