default_platform(:android)

platform :android do
  desc "Upload the prod AAB to Google Play closed testing"
  lane :deploy_closed do
    aab_path = Dir["../build/app/outputs/bundle/**/*.aab"].first
    UI.user_error!("No AAB found under build/app/outputs/bundle") unless aab_path

    notes = "Automated upload"
    begin
      notes = sh("git log -1 --pretty=%s").strip
    rescue
      UI.message("Falling back to default release notes")
    end

    supply(
      aab: aab_path,
      track: "closed",
      release_status: "completed",
      json_key_file: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"] || "config/google_play_key.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_notes: { "en-US" => notes }
    )
  end
end
